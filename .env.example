# Server
PORT=5000

# Database
MONGODB_URI=your_mongodb_atlas_connection_string

# Auth
JWT_SECRET=your_jwt_secret_key

# Cloudinary (upload gambar)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET_PUBLIC=your_public_upload_preset_name

# OneSignal (push notification)
ONESIGNAL_APP_ID=your_onesignal_app_id      
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# LocationIQ (geocoding/maps)
LOCATIONIQ_SERVER_KEY=your_locationiq_server_key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://rangkulmap.vercel.app